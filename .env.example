# Google Analytics / Google Ads
# Google Analytics ID (GA4 format: G-XXXXXXXXXX) or Google Ads ID (AW-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Google Ads ID (AW-XXXXXXXXXX)
# Required for Google Ads conversion tracking. Set this to the Google Ads account ID
# that matches your conversion tags (e.g., AW-17758590818 for Hero Solutions Oy)
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Google Ads Conversion Tracking
# Comma-separated list of conversion IDs for quote requests
# Format: "AW-XXXXXXXXX/CONVERSION_LABEL, AW-YYYYYYYYY/CONVERSION_LABEL"
# If not set, defaults will be used from config-global.ts
NEXT_PUBLIC_GOOGLE_ADS_QUOTE_CONVERSIONS=

# Comma-separated list of conversion IDs for join requests
# Format: "AW-XXXXXXXXX/CONVERSION_LABEL, AW-YYYYYYYYY/CONVERSION_LABEL"
# If not set, defaults will be used from config-global.ts
NEXT_PUBLIC_GOOGLE_ADS_JOIN_CONVERSIONS=

# Assets Directory
# Optional: Custom assets directory path
NEXT_PUBLIC_ASSETS_DIR=

# Google Maps API Key
# Required if using Google Maps features
NEXT_PUBLIC_MAP_API=
